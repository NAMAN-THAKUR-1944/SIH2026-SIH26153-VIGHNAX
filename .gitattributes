* text=auto

# binary artifacts: never touch line endings (the weights are checked against models/SHA256SUMS)
*.pt      binary
*.joblib  binary
models/*.json binary
*.gz      binary
*.bz2     binary
*.png     binary
*.pdf     binary
*.docx    binary
*.pptx    binary
*.woff2   binary
models/SHA256SUMS text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
